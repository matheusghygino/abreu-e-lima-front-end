---
import { getAllPhotos, getAllVideos } from "../../lib/wordpress/gallery";

const allPhotos = await getAllPhotos();
const allVideos = await getAllVideos();
const latestPhotos = allPhotos.slice(0, 4);
const latestVideos = allVideos.slice(0, 4);
---

<section class="bg-bg-muted">
  <div class="mx-auto max-w-7xl px-4 py-16 space-y-14">
    <!-- HEADER -->
    <div>
      <h2 class="text-2xl font-bold mb-2">Galeria</h2>
      <p class="text-text-secondary">
        Registros das atividades, atos e formações do Comitê.
      </p>
    </div>

    <!-- FOTOS -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-xl font-semibold">Fotos</h3>
        <a href="/galeria/fotos" class="text-primary font-semibold hover:underline">
          Ver todas →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-4">
        {latestPhotos.map((photo) => (
          <figure class="overflow-hidden rounded-lg bg-bg shadow-sm">
            <img
              src={photo.src}
              alt={photo.alt}
              class="h-48 w-full object-cover"
              loading="lazy"
            />
            <figcaption class="p-3 text-sm">
              <p class="font-medium">{photo.title}</p>
              <span class="text-xs text-text-secondary">{photo.date}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <!-- VÍDEOS -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-xl font-semibold">Vídeos</h3>
        <a href="/galeria/videos" class="text-primary font-semibold hover:underline">
          Ver todos →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-4">
        {latestVideos.map((video) => (
          <div class="overflow-hidden rounded-lg bg-bg shadow-sm">
            <div class="aspect-video w-full bg-bg-muted flex items-center justify-center text-text-secondary text-sm">
              {video.src ? (
                <video controls preload="metadata" poster={video.poster || undefined} class="h-full w-full object-cover">
                  <source src={video.src} />
                </video>
              ) : (
                <span>Vídeo indisponível</span>
              )}
            </div>
            <div class="p-3 text-sm">
              <p class="font-medium">{video.title}</p>
              <span class="text-xs text-text-secondary">{video.date}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
