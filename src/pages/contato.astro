---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import ContactForm from "../components/Forms/ContactForm.astro";
---
<BaseLayout title="Contato — Comitê Anti-Imperialista Abreu e Lima">
  <main>
    <Section title="Contato" subtitle="Fale com o Comitê">
      <div class="grid gap-8 md:grid-cols-2">
        <ContactForm />

        <div class="rounded-2xl border border-border p-6">
          <div class="text-sm font-semibold text-text-primary">Canais</div>
          <div class="mt-3 space-y-2 text-sm text-text-secondary">
            <div><span class="text-text-secondary/70">E-mail:</span> abreuelima@coletivo.net.br</div>
          </div>

          <div class="mt-6 rounded-xl bg-bg-muted p-4 text-xs text-text-secondary">
            Nos acompanhe nas redes sociais e fique por dentro das nossas atividades.
          </div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
