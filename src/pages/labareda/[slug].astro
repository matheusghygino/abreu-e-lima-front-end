---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsHeader from "../../components/news/NewsHeader.astro";
import NewsBody from "../../components/news/NewsBody.astro";
import NewsTags from "../../components/news/NewsTags.astro";
import { getAllArticles, getArticleBySlug } from "../../lib/wordpress/labareda";

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = slug ? await getArticleBySlug(slug) : null;

if (!post) {
  throw new Error(`Artigo não encontrado: ${slug}`);
}
---

<BaseLayout title={`${post.title} — Labareda — Comitê Anti-Imperialista Abreu e Lima`}>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <NewsHeader post={post} />
    <NewsBody post={post} />
    <NewsTags tags={post.tags} />
  </article>
</BaseLayout>
